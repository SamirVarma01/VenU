# Copy to .env and fill in from Firebase Console > Project Settings > General
# > Your apps > Web app config. These are EXPO_PUBLIC_ so they get inlined
# into the client bundle at build time (this is normal for Firebase web
# config — it's not a secret, access control is enforced by firestore.rules).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=venyou-9ef84
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
