# Firebase Console -> gear icon -> Project settings -> Service accounts tab
# -> "Generate new private key". Save the downloaded file as
# scripts/service-account.json (gitignored) and leave this path as-is,
# or point it elsewhere.
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# developer.ticketmaster.com -> sign up -> create an app -> "Consumer Key"
TICKETMASTER_API_KEY=
